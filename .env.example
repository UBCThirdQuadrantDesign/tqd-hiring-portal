# Supabase -- Project Settings -> API Keys
# Modern keys only. If a value below still starts with "eyJ" it is a legacy
# JWT key: replace it with an sb_publishable_ / sb_secret_ key, then disable
# the legacy keys in the dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...) -- shipped to the browser, RLS-bound.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (sb_secret_...) -- server-only, bypasses RLS. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Bearer token for the daily orphan-sweep cron (app/api/cron/sweep-orphans).
# Must also be set in the Vercel project's env vars -- that's what makes
# Vercel attach it as the Authorization header when it invokes the cron.
CRON_SECRET=...
